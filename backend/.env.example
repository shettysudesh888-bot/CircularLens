# Copy to backend/.env or configure these in your local process environment.
# Never commit the populated file.
GEMINI_API_KEY=replace-with-your-gemini-api-key
CIRCULARLENS_AUTH_SECRET=replace-with-a-long-random-secret
CIRCULARLENS_EMBEDDING_PROVIDER=gemini
CIRCULARLENS_GENERATION_MODEL=gemini-3.1-flash-lite
CIRCULARLENS_GENERATION_FALLBACK_MODEL=gemini-3.5-flash-lite
CIRCULARLENS_GENERATION_MAX_ATTEMPTS=3
CIRCULARLENS_EMBEDDING_BATCH_SIZE=20
CIRCULARLENS_ENABLE_REMINDER_SCHEDULER=true
# Optional paths; leave unset to use backend/data locally.
# CIRCULARLENS_DB_PATH=C:\path\outside\the\repository\app.db
# CIRCULARLENS_INDEX_DIR=C:\path\outside\the\repository\semantic_index
# CIRCULARLENS_UPLOAD_DIR=C:\path\outside\the\repository\uploads
